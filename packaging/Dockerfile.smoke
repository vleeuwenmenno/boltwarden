FROM debian:bookworm-slim
COPY *.deb /tmp/
RUN apt-get update && apt-get install -y --no-install-recommends /tmp/*.deb python3
RUN test -f /usr/lib/systemd/user/boltwarden.service && \
    test -f /usr/share/licenses/boltwarden/LICENSE && \
    test -x /usr/bin/boltwarden-setup
RUN python3 - <<'PY'
import json, struct, subprocess
result = subprocess.run(['/usr/bin/boltwarden', 'native-host'], input=b'', capture_output=True, check=True)
messages, data = [], result.stdout
while data:
    length = struct.unpack('=I', data[:4])[0]
    messages.append(json.loads(data[4:4+length]))
    data = data[4+length:]
assert messages[0]['type'] == 'HostContext', messages
assert messages[1]['code'] == 'DaemonUnavailable', messages
print('Installed binary starts and native framing works without a daemon')
PY
RUN dpkg --remove boltwarden && test ! -e /usr/bin/boltwarden
