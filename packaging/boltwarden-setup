#!/bin/sh
# Run as the desktop user after installing a package.
set -eu
if [ "$(id -u)" -eq 0 ]; then
    echo 'Run boltwarden-setup as your desktop user, without sudo.' >&2
    exit 1
fi
case "${1:-}" in
    --register-browsers) register=yes ;;
    --help|-h)
        echo 'Usage: boltwarden-setup [--register-browsers]'
        echo 'Offers to register detected browsers. Start at login is in Settings, General.'
        exit 0 ;;
    '')
        if [ ! -t 0 ]; then
            echo 'Run interactively, or pass --register-browsers to opt in explicitly.' >&2
            exit 2
        fi
        printf 'Connect detected browsers to Boltwarden (installs the native messaging host)? [y/N] '
        read -r register ;;
    *) echo 'Unknown option. Use --help.' >&2; exit 2 ;;
esac
case "$register" in
    y|Y|yes|YES)
        /usr/bin/boltwarden install-browser --detected --path /usr/bin/boltwarden
        echo 'Next: enable Browser integration in Boltwarden Settings, then pair from the extension.' ;;
esac
echo 'To start Boltwarden at login, turn on Start at login in Settings, General.'
